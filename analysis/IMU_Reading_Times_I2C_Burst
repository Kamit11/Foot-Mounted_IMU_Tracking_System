import numpy as np
import matplotlib.pyplot as plt
import arduino_logger as al


prefix = "IMU_reading_times_I2C_Optimized_Burst"
header = "t_us,seq,ax,ay,az,gx,gy,gz,t_imu_us,t_serial_us,missed"

# csv_filepath = al.collect_serial_data(header = header, file_prefix=prefix)

filepath = "data/temp_data/IMU_reading_times_I2C_Optimized_Burst_07-08-2026_17-57-48.csv"

d = np.loadtxt(filepath, delimiter=',', skiprows=1)
t_us,seq,ax,ay,az,gx,gy,gz,t_imu_us,t_serial_us,missed = d.T

t_imu_mean = t_imu_us.mean()
t_serial_mean = t_serial_us.mean()

print(f"Average IMU read time: {t_imu_mean:.1f} us")
print(f"Average Serial read time: {t_serial_mean:.1f} us")

print("\n=== IMU DATA ANALYSIS ===")
print(f"Missed deadline counter: {missed[-1]}")
print(f"I2C read cost (t_imu): mean={t_imu_mean:.1f} (us) | max={t_imu_us.max():.0f} (us)")
print(f"Serial write cost (t_serial): mean={t_serial_mean:.1f} (us) | max={t_serial_us.max():.0f} (us)")
print("===========================")


fig, ax = plt.subplots(1, 2, figsize=(12, 4))
ax[0].hist(t_imu_us, bins = np.arange(t_imu_us.min()-0.5, t_imu_us.max()+1.5), log=True)
ax[0].axvline(t_imu_mean, color='r', ls='--', label=f'mean: {t_imu_mean:.0f} (us)')
ax[0].set_xlabel("t_imu (us)")
ax[0].legend()

ax[1].hist(t_serial_us, bins = np.arange(t_serial_us.min()-0.5, t_serial_us.max()+1.5), log=True)
ax[1].axvline(t_serial_mean, color='r', ls='--', label=f'mean: {t_serial_mean:.0f} (us)')
ax[1].set_xlabel("t_serial (us)")
ax[1].legend()


plt.tight_layout()
plt.savefig(f"{filepath.replace('.csv', '.png')}", dpi=120)

plt.show()
import serial
import time
import os
import numpy as np
import matplotlib.pyplot as plt
from datetime import datetime
from pathlib import Path

script_dir = Path(__file__).parent

# Define the filename base to avoid repeating it
filename_base = "fpu_enabled_benchmark_01-08-2026_21-45-09"
file_path = script_dir / f"{filename_base}.csv"

# Load the collected data and analyze it
d = np.loadtxt(file_path, delimiter=',', skiprows=1)
seq, work, mismatches = d.T

mean_work = work.mean()
total_mismatches = mismatches[-1]
dropped_lines = np.sum(np.diff(seq) != 1)

print("\n=== BENCHMARK RESULTS ===")
print(f"Total Samples:    {len(work)}")
print(f"Dropped Lines:    {dropped_lines}")
print(f"Average Work Time: {mean_work:.2f} us")
print(f"FPU Corruptions:  {total_mismatches}")
print("=========================\n")

if total_mismatches > 0:
    print("WARNING: FPU CONTEXT CORRUPTION DETECTED. REVERT FLAGS.")
else:
    print("SUCCESS: FPU CONTEXT IS SAFE.")

# --- DUAL PLOT GENERATION ---
fig, ax = plt.subplots(1, 2, figsize=(11,4))

# Left subplot: Histogram of the work time distribution
ax[0].hist(work, bins=np.arange(work.min()-0.5, work.max()+1.5), log=True)
ax[0].axvline(mean_work, color='r', ls='--')
ax[0].set_xlabel("Work Time (us)")
ax[0].set_ylabel("Frequency (Log Scale)")
ax[0].legend([f'Mean Work Time: {mean_work:.1f} us'])

# Right subplot: Line plot over time to spot periodic anomalies
ax[1].plot(work, lw=0.4)
ax[1].axhline(mean_work, color='r', ls='--')
ax[1].set_xlabel("sample")
ax[1].set_ylabel("Work Time (us)")
ax[1].legend([f'Mean Work Time: {mean_work:.1f} us'])

plt.tight_layout()
plt.savefig(script_dir / f"{filename_base}_dual_plot.png", dpi=120)
plt.show()